#!/usr/bin/env node
'use strict';

const http = require('http');
const path = require('path');
const fs = require('fs');
const { spawn } = require('child_process');

const inputPath = process.argv[2];

if (!inputPath) {
  // No path arg — try to reach a running LOGAN, else launch it.
  tryApi(null, () => {
    launchElectron(null);
  });
} else {
  // Accept a file OR a folder: `logan app.log` or `logan ./logs/` (or `logan .`).
  const abs = path.resolve(inputPath);
  let stat;
  try {
    stat = fs.statSync(abs);
  } catch {
    console.error(`logan: path not found: ${abs}`);
    process.exit(1);
  }
  const target = { path: abs, isDir: stat.isDirectory() };
  tryApi(target, () => {
    launchElectron(abs);
  });
}

// `target` is { path, isDir } or null (status ping). A folder posts to
// /api/open-folder, a file to /api/open-file; both fall back to a cold launch.
function tryApi(target, onFail) {
  const isFolder = !!(target && target.isDir);
  const postData = target
    ? JSON.stringify(isFolder ? { folderPath: target.path } : { filePath: target.path })
    : null;
  const options = {
    hostname: '127.0.0.1',
    port: 19532,
    path: target ? (isFolder ? '/api/open-folder' : '/api/open-file') : '/api/status',
    method: target ? 'POST' : 'GET',
    headers: target
      ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(postData) }
      : {},
    timeout: 2000,
  };

  const req = http.request(options, (res) => {
    let body = '';
    res.on('data', (chunk) => (body += chunk));
    res.on('end', () => {
      if (target) {
        console.log(`Opened ${path.basename(target.path)} in LOGAN`);
      } else {
        console.log('LOGAN is already running');
      }
    });
  });

  req.on('error', () => onFail());
  req.on('timeout', () => { req.destroy(); onFail(); });

  if (postData) req.write(postData);
  req.end();
}

function launchElectron(absPath) {
  // Find the electron binary and app root
  const appRoot = path.resolve(__dirname, '..');
  const electronPath = path.join(appRoot, 'node_modules', '.bin', 'electron');

  if (!fs.existsSync(electronPath)) {
    console.error('logan: electron not found. Run "npm install" in the LOGAN directory first.');
    process.exit(1);
  }

  const args = [];
  if (process.platform === 'linux') args.push('--no-sandbox');
  args.push(appRoot);
  if (absPath) args.push('--', absPath);

  const child = spawn(electronPath, args, {
    detached: true,
    stdio: 'ignore',
    env: { ...process.env },
  });
  child.unref();

  if (absPath) {
    console.log(`Launching LOGAN with ${path.basename(absPath)}...`);
  } else {
    console.log('Launching LOGAN...');
  }
}
